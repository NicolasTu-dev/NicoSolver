/* TexasSolver - Fintech / Trading theme */

QWidget {
    background-color: #05070d;
    color: #e8ecf4;
    font-family: "Space Grotesk", "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #05070d;
}

QLabel {
    background: transparent;
    color: #e8ecf4;
}

QLabel:disabled {
    color: #5a6478;
}

QPushButton {
    background-color: #00e5a0;
    color: #05070d;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #1fedb0;
}

QPushButton:pressed {
    background-color: #00b87e;
}

QPushButton:disabled {
    background-color: #161b26;
    color: #5a6478;
}

QPushButton[flat="true"], QToolButton {
    background-color: #0d1017;
    color: #e8ecf4;
    border: 1px solid #1c2130;
    border-radius: 4px;
    padding: 4px 10px;
}

QToolButton:hover {
    background-color: #161b26;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0d1017;
    color: #e8ecf4;
    border: 1px solid #1c2130;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #00e5a0;
    selection-color: #05070d;
    font-family: "Consolas", "Space Grotesk", monospace;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #00e5a0;
}

QLineEdit:disabled, QTextEdit:disabled, QSpinBox:disabled {
    color: #5a6478;
    background-color: #05070d;
}

QComboBox {
    background-color: #0d1017;
    color: #e8ecf4;
    border: 1px solid #1c2130;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid #00e5a0;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #0d1017;
    color: #e8ecf4;
    border: 1px solid #1c2130;
    selection-background-color: #00e5a0;
    selection-color: #05070d;
    outline: none;
}

QGroupBox {
    background-color: #0d1017;
    border: 1px solid #1c2130;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #5a6478;
}

QCheckBox, QRadioButton {
    background: transparent;
    color: #e8ecf4;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #2a3040;
    background-color: #0d1017;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 2px solid #5a6478;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #00e5a0;
    border: 2px solid #00e5a0;
    image: url(:/resources/icons/checkmark.svg);
}

QTabWidget::pane {
    background-color: #05070d;
    border: 1px solid #1c2130;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #05070d;
    color: #5a6478;
    border: 1px solid #1c2130;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #0d1017;
    color: #e8ecf4;
}

QTabBar::tab:hover:!selected {
    color: #e8ecf4;
}

QTableView, QTreeView, QListView {
    background-color: #0d1017;
    color: #e8ecf4;
    border: 1px solid #1c2130;
    border-radius: 4px;
    gridline-color: #1c2130;
    selection-background-color: #00e5a0;
    selection-color: #05070d;
}

QHeaderView::section {
    background-color: #05070d;
    color: #5a6478;
    border: none;
    border-right: 1px solid #1c2130;
    border-bottom: 1px solid #1c2130;
    padding: 4px 8px;
}

QScrollBar:vertical {
    background-color: #05070d;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #1c2130;
    border-radius: 5px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00e5a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #05070d;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #1c2130;
    border-radius: 5px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #00e5a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QProgressBar {
    background-color: #0d1017;
    border: 1px solid #1c2130;
    border-radius: 4px;
    text-align: center;
    color: #e8ecf4;
}

QProgressBar::chunk {
    background-color: #00e5a0;
    border-radius: 3px;
}

QToolTip {
    background-color: #0d1017;
    color: #e8ecf4;
    border: 1px solid #1c2130;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar {
    background-color: #05070d;
    color: #e8ecf4;
}

QMenuBar::item:selected {
    background-color: #1c2130;
}

QMenu {
    background-color: #0d1017;
    color: #e8ecf4;
    border: 1px solid #1c2130;
}

QMenu::item:selected {
    background-color: #00e5a0;
    color: #05070d;
}

QStatusBar {
    background-color: #05070d;
    color: #5a6478;
}

QSplitter::handle {
    background-color: #1c2130;
}

#wizardNavStrip {
    background-color: #05070d;
    border-bottom: 1px solid #1c2130;
}

#wizardStepLabel {
    color: #00e5a0;
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

#wizardStepSubtitle {
    color: #8792a6;
    font-size: 13px;
    padding-top: 2px;
    padding-bottom: 4px;
}

#ipBetSizesHeader, #oopBetSizesHeader {
    color: #00e5a0;
    font-weight: 700;
    font-size: 13px;
    padding-top: 6px;
}

#helpButton {
    background-color: #00e5a0;
    color: #05070d;
    border: none;
    border-radius: 4px;
    font-weight: 700;
    padding: 6px 14px;
}

#helpButton:hover {
    background-color: #1fedb0;
}

#exampleBanner {
    background-color: rgba(0, 229, 160, 0.10);
    border: 1px solid #00e5a0;
    border-radius: 4px;
    color: #b8f5db;
    font-size: 13px;
    padding: 8px;
    margin-top: 4px;
}

#wizardNextButton {
    background-color: #00e5a0;
    color: #05070d;
}

#wizardBackButton {
    background-color: #0d1017;
    color: #e8ecf4;
    border: 1px solid #1c2130;
}

#wizardBackButton:disabled {
    color: #5a6478;
    background-color: #05070d;
}

#resultsLegend {
    background-color: #0d1017;
    border: 1px solid #1c2130;
    border-radius: 4px;
    padding: 6px 10px;
}

#resultsLegend QLabel {
    color: #e8ecf4;
    font-size: 11px;
}

#seatFelt {
    background-color: #0d1017;
    border: 4px solid #00e5a0;
    border-radius: 8px;
}

#seatUTG, #seatCO, #seatBTN, #seatSB, #seatBB {
    background-color: #05070d;
    color: #e8ecf4;
    border: 2px solid #00e5a0;
    border-radius: 4px;
    font-weight: 700;
}

#simplePotButton, #threeBetPotButton {
    background-color: #00e5a0;
    color: #05070d;
    font-weight: 700;
}

#seatUTG:disabled, #seatCO:disabled, #seatBTN:disabled, #seatSB:disabled, #seatBB:disabled {
    background-color: #05070d;
    color: #303645;
    border: 2px dashed #1c2130;
}
