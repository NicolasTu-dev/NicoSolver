/* TexasSolver - Poker Room theme */

QWidget {
    background-color: #0a1810;
    color: #e8f0ea;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #0a1810;
}

QLabel {
    background: transparent;
    color: #e8f0ea;
}

QLabel:disabled {
    color: #7fae94;
}

QPushButton {
    background-color: #d4af37;
    color: #132118;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 700;
}

QPushButton:hover {
    background-color: #e8c250;
}

QPushButton:pressed {
    background-color: #b8941f;
}

QPushButton:disabled {
    background-color: #1c2f22;
    color: #5c7a6a;
}

QPushButton[flat="true"], QToolButton {
    background-color: #132118;
    color: #e8f0ea;
    border: 1px solid #2a4a38;
    border-radius: 6px;
    padding: 4px 10px;
}

QToolButton:hover {
    background-color: #1c2f22;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #132118;
    color: #e8f0ea;
    border: 1px solid #2a4a38;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #d4af37;
    selection-color: #132118;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #d4af37;
}

QLineEdit:disabled, QTextEdit:disabled, QSpinBox:disabled {
    color: #5c7a6a;
    background-color: #0a1810;
}

QComboBox {
    background-color: #132118;
    color: #e8f0ea;
    border: 1px solid #2a4a38;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid #d4af37;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #132118;
    color: #e8f0ea;
    border: 1px solid #2a4a38;
    selection-background-color: #d4af37;
    selection-color: #132118;
    outline: none;
}

QGroupBox {
    background-color: #132118;
    border: 1px solid #2a4a38;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #7fae94;
}

QCheckBox, QRadioButton {
    background: transparent;
    color: #e8f0ea;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #4a6e5a;
    background-color: #132118;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 2px solid #7fae94;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #22c55e;
    border: 2px solid #22c55e;
    image: url(:/resources/icons/checkmark.svg);
}

QTabWidget::pane {
    background-color: #0a1810;
    border: 1px solid #2a4a38;
    border-radius: 8px;
}

QTabBar::tab {
    background-color: #06120b;
    color: #7fae94;
    border: 1px solid #2a4a38;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #132118;
    color: #e8f0ea;
}

QTabBar::tab:hover:!selected {
    color: #e8f0ea;
}

QTableView, QTreeView, QListView {
    background-color: #132118;
    color: #e8f0ea;
    border: 1px solid #2a4a38;
    border-radius: 6px;
    gridline-color: #2a4a38;
    selection-background-color: #d4af37;
    selection-color: #132118;
}

QHeaderView::section {
    background-color: #06120b;
    color: #7fae94;
    border: none;
    border-right: 1px solid #2a4a38;
    border-bottom: 1px solid #2a4a38;
    padding: 4px 8px;
}

QScrollBar:vertical {
    background-color: #0a1810;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #2a4a38;
    border-radius: 5px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #d4af37;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #0a1810;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #2a4a38;
    border-radius: 5px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #d4af37;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QProgressBar {
    background-color: #132118;
    border: 1px solid #2a4a38;
    border-radius: 6px;
    text-align: center;
    color: #e8f0ea;
}

QProgressBar::chunk {
    background-color: #d4af37;
    border-radius: 5px;
}

QToolTip {
    background-color: #132118;
    color: #e8f0ea;
    border: 1px solid #2a4a38;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar {
    background-color: #06120b;
    color: #e8f0ea;
}

QMenuBar::item:selected {
    background-color: #2a4a38;
}

QMenu {
    background-color: #132118;
    color: #e8f0ea;
    border: 1px solid #2a4a38;
}

QMenu::item:selected {
    background-color: #d4af37;
    color: #132118;
}

QStatusBar {
    background-color: #06120b;
    color: #7fae94;
}

QSplitter::handle {
    background-color: #2a4a38;
}

#wizardNavStrip {
    background-color: #06120b;
    border-bottom: 1px solid #2a4a38;
}

#wizardStepLabel {
    color: #d4af37;
    font-weight: 700;
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: "Cinzel", "Segoe UI", serif;
}

#wizardStepSubtitle {
    color: #a9c9b6;
    font-size: 13px;
    padding-top: 2px;
    padding-bottom: 4px;
}

#ipBetSizesHeader, #oopBetSizesHeader {
    color: #d4af37;
    font-weight: 700;
    font-size: 13px;
    padding-top: 6px;
}

#helpButton {
    background-color: #22c55e;
    color: #06120b;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    padding: 6px 14px;
}

#helpButton:hover {
    background-color: #34d873;
}

#exampleBanner {
    background-color: rgba(212, 175, 55, 0.12);
    border: 1px solid #d4af37;
    border-radius: 6px;
    color: #f0e6c8;
    font-size: 13px;
    padding: 8px;
    margin-top: 4px;
}

#wizardNextButton {
    background-color: #d4af37;
    color: #132118;
}

#wizardBackButton {
    background-color: #132118;
    color: #e8f0ea;
    border: 1px solid #2a4a38;
}

#wizardBackButton:disabled {
    color: #5c7a6a;
    background-color: #0a1810;
}

#resultsLegend {
    background-color: #132118;
    border: 1px solid #2a4a38;
    border-radius: 6px;
    padding: 6px 10px;
}

#resultsLegend QLabel {
    color: #e8f0ea;
    font-size: 11px;
}

#seatFelt {
    background-color: #132118;
    border: 4px solid #d4af37;
    border-radius: 120px;
}

#seatUTG, #seatCO, #seatBTN, #seatSB, #seatBB {
    background-color: #1c2f22;
    color: #e8f0ea;
    border: 2px solid #d4af37;
    border-radius: 8px;
    font-weight: 700;
}

#simplePotButton, #threeBetPotButton {
    background-color: #d4af37;
    color: #132118;
    font-weight: 700;
}

#seatUTG:disabled, #seatCO:disabled, #seatBTN:disabled, #seatSB:disabled, #seatBB:disabled {
    background-color: #0a1810;
    color: #3d5545;
    border: 2px dashed #2a4a38;
}
